import React, { useEffect, useState } from "react";


import ProductManagement from "./ProductManagement.jsx";
import OrderManagement from "./OrderManagement.jsx";
import CustomOrderManagement from "./CustomOrderManagement.jsx";
const API_PRODUCTS = "http://localhost:8080/api/products";
const API_ORDERS = "http://localhost:8080/api/orders";

function AdminDashboard() {
  const [products, setProducts] = useState([]);
  const [orders, setOrders] = useState([]);
  const [activeMenu, setActiveMenu] = useState("Dashboard");
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    try {
      setLoading(true);

      const [productsResponse, ordersResponse] = await Promise.all([
        fetch(API_PRODUCTS),
        fetch(API_ORDERS),
      ]);

      if (!productsResponse.ok) {
        throw new Error("Failed to load products");
      }

      if (!ordersResponse.ok) {
        throw new Error("Failed to load orders");
      }

      const productsData = await productsResponse.json();
      const ordersData = await ordersResponse.json();

      setProducts(Array.isArray(productsData) ? productsData : []);
      setOrders(Array.isArray(ordersData) ? ordersData : []);
    } catch (error) {
      console.error("Error loading dashboard:", error);
    } finally {
      setLoading(false);
    }
  };

  const totalSales = orders.reduce(
    (sum, order) => sum + Number(order.totalAmount || 0),
    0
  );

  const pendingOrders = orders.filter((order) => {
    const status = String(order.status || "").toUpperCase();

    return status === "PLACED" || status === "PENDING";
  }).length;

  const getImageUrl = (imageUrl) => {
    if (!imageUrl) {
      return "/products/tote-bow-hearts.jpeg";
    }

    if (imageUrl.startsWith("http")) {
      return imageUrl;
    }

    return imageUrl;
  };

  const formatDate = (date) => {
    if (!date) {
      return "-";
    }

    try {
      return new Date(date).toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      });
    } catch {
      return "-";
    }
  };

  const menuItems = [
    {
      name: "Dashboard",
      icon: "▦",
    },
    {
      name: "Products",
      icon: "🛍",
    },
    {
      name: "Orders",
      icon: "📦",
    },
    {
      name: "Inventory",
      icon: "▤",
    },
    {
      name: "Custom Orders",
      icon: "✦",
    },
    {
      name: "Delivery",
      icon: "🚚",
    },
    {
      name: "Payments",
      icon: "₹",
    },
    {
      name: "Settings",
      icon: "⚙",
    },
  ];

  if (loading) {
    return (
      <div className="admin-loading">
        <div className="loading-circle"></div>
        <h3>Loading LunaLoop Dashboard...</h3>
      </div>
    );
  }

  return (
    <div className="admin-layout">

      {/* ================= SIDEBAR ================= */}

      <aside className="admin-sidebar">

        <div className="admin-logo">

          <div className="logo-symbol">
            L
          </div>

          <div>
            <h2>LunaLoop</h2>
            <span>Admin Panel</span>
          </div>

        </div>

        <div className="sidebar-title">
          MAIN MENU
        </div>

        <nav className="admin-nav">

          {menuItems.map((item) => (
            <button
              key={item.name}
              className={`nav-item ${
                activeMenu === item.name ? "active" : ""
              }`}
              onClick={() => setActiveMenu(item.name)}
            >

              <span className="nav-icon">
                {item.icon}
              </span>

              <span>
                {item.name}
              </span>

            </button>
          ))}

        </nav>

        <div className="sidebar-bottom">

          <div className="admin-help">

            <div className="help-icon">
              ?
            </div>

            <div>
              <strong>
                Need Help?
              </strong>

              <p>
                Contact LunaLoop support
              </p>
            </div>

          </div>

          <button
            className="logout-btn"
            onClick={() => {
              sessionStorage.removeItem(
                "lunaloopAdminLoggedIn"
              );

              window.location.href = "/admin";
            }}
          >

            <span>
              ↪
            </span>

            Logout

          </button>

        </div>

      </aside>

      {/* ================= MAIN ================= */}

      <main className="admin-main">

        {/* ================= TOP HEADER ================= */}

        <header className="admin-header">

          <div className="mobile-brand">

            <div className="logo-symbol">
              L
            </div>

            <strong>
              LunaLoop
            </strong>

          </div>

          <div className="admin-search">

            <span>
              ⌕
            </span>

            <input
              type="text"
              placeholder="Search products, orders..."
            />

          </div>

          <div className="header-right">

            <button className="notification-btn">
              ♡
              <span className="notification-dot"></span>
            </button>

            <div className="admin-profile">

              <div className="profile-avatar">
                G
              </div>

              <div className="profile-info">

                <strong>
                  Admin
                </strong>

                <span>
                  Store Manager
                </span>

              </div>

              <span className="profile-arrow">
                ⌄
              </span>

            </div>

          </div>

        </header>

        {/* ==================================================
            DASHBOARD
        ================================================== */}

        {activeMenu === "Dashboard" && (

          <div className="dashboard-content">

            {/* PAGE HEADING */}

            <div className="page-heading">

              <div>

                <h1>
                  Dashboard
                </h1>

                <p>
                  Welcome back! Here's what's happening with your
                  store today.
                </p>

              </div>

              <button
                className="refresh-btn"
                onClick={fetchData}
              >
                ↻ Refresh
              </button>

            </div>

            {/* ================= STATISTICS ================= */}

            <section className="stats-grid">

              {/* PRODUCTS */}

              <div className="stat-card">

                <div className="stat-icon purple">
                  🛍
                </div>

                <div className="stat-info">

                  <span>
                    Total Products
                  </span>

                  <h2>
                    {products.length}
                  </h2>

                  <small className="positive">
                    ↑ Active products
                  </small>

                </div>

              </div>

              {/* ORDERS */}

              <div className="stat-card">

                <div className="stat-icon pink">
                  📦
                </div>

                <div className="stat-info">

                  <span>
                    Total Orders
                  </span>

                  <h2>
                    {orders.length}
                  </h2>

                  <small className="positive">
                    ↑ All orders
                  </small>

                </div>

              </div>

              {/* SALES */}

              <div className="stat-card">

                <div className="stat-icon green">
                  ₹
                </div>

                <div className="stat-info">

                  <span>
                    Total Sales
                  </span>

                  <h2>
                    ₹
                    {totalSales.toLocaleString("en-IN")}
                  </h2>

                  <small className="positive">
                    ↑ Order revenue
                  </small>

                </div>

              </div>

              {/* PENDING */}

              <div className="stat-card">

                <div className="stat-icon orange">
                  ⏳
                </div>

                <div className="stat-info">

                  <span>
                    Pending Orders
                  </span>

                  <h2>
                    {pendingOrders}
                  </h2>

                  <small className="warning">
                    Needs attention
                  </small>

                </div>

              </div>

            </section>

            {/* ================= TWO COLUMNS ================= */}

            <section className="dashboard-columns">

              {/* RECENT ORDERS */}

              <div className="dashboard-card orders-card">

                <div className="card-header">

                  <div>

                    <h3>
                      Recent Orders
                    </h3>

                    <p>
                      Latest customer orders
                    </p>

                  </div>

                  <button
                    onClick={() =>
                      setActiveMenu("Orders")
                    }
                    className="view-all"
                  >
                    View All →
                  </button>

                </div>

                <div className="orders-table">

                  <div className="table-heading">

                    <span>
                      ORDER
                    </span>

                    <span>
                      CUSTOMER
                    </span>

                    <span>
                      AMOUNT
                    </span>

                    <span>
                      STATUS
                    </span>

                  </div>

                  {orders.length === 0 ? (

                    <div className="empty-state">

                      <div>
                        📦
                      </div>

                      <p>
                        No orders yet
                      </p>

                    </div>

                  ) : (

                    orders
                      .slice()
                      .reverse()
                      .slice(0, 5)
                      .map((order) => (

                        <div
                          className="order-row"
                          key={order.id}
                        >

                          <div className="order-number">

                            <strong>
                              #{order.id}
                            </strong>

                            <span>
                              {formatDate(
                                order.createdAt
                              )}
                            </span>

                          </div>

                          <div className="customer-name">

                            {order.fullName ||
                              "Customer"}

                          </div>

                          <div className="order-amount">

                            ₹
                            {Number(
                              order.totalAmount || 0
                            ).toLocaleString("en-IN")}

                          </div>

                          <div>

                            <span
                              className={`status-badge ${String(
                                order.status ||
                                  "PLACED"
                              ).toLowerCase()}`}
                            >
                              {order.status ||
                                "PLACED"}
                            </span>

                          </div>

                        </div>

                      ))

                  )}

                </div>

              </div>

              {/* QUICK ACTIONS */}

              <div className="dashboard-card quick-card">

                <div className="card-header">

                  <div>

                    <h3>
                      Quick Actions
                    </h3>

                    <p>
                      Manage your store
                    </p>

                  </div>

                </div>

                <div className="quick-actions">

                  {/* ADD PRODUCT */}

                  <button
                    onClick={() =>
                      setActiveMenu("Products")
                    }
                    className="quick-action"
                  >

                    <div className="quick-icon purple">
                      ＋
                    </div>

                    <div>

                      <strong>
                        Add Product
                      </strong>

                      <span>
                        Create a new product
                      </span>

                    </div>

                    <b>
                      →
                    </b>

                  </button>

                  {/* ORDERS */}

                  <button
                    onClick={() =>
                      setActiveMenu("Orders")
                    }
                    className="quick-action"
                  >

                    <div className="quick-icon pink">
                      📦
                    </div>

                    <div>

                      <strong>
                        Manage Orders
                      </strong>

                      <span>
                        View customer orders
                      </span>

                    </div>

                    <b>
                      →
                    </b>

                  </button>

                  {/* INVENTORY */}

                  <button
                    onClick={() =>
                      setActiveMenu("Inventory")
                    }
                    className="quick-action"
                  >

                    <div className="quick-icon orange">
                      ▤
                    </div>

                    <div>

                      <strong>
                        Check Inventory
                      </strong>

                      <span>
                        Manage stock levels
                      </span>

                    </div>

                    <b>
                      →
                    </b>

                  </button>

                  {/* CUSTOM */}

                  <button
                    onClick={() =>
                      setActiveMenu("Custom Orders")
                    }
                    className="quick-action"
                  >

                    <div className="quick-icon green">
                      ✦
                    </div>

                    <div>

                      <strong>
                        Custom Requests
                      </strong>

                      <span>
                        View custom orders
                      </span>

                    </div>

                    <b>
                      →
                    </b>

                  </button>

                </div>

              </div>

            </section>

            {/* ================= PRODUCTS ================= */}

            <section className="dashboard-card products-section">

              <div className="card-header">

                <div>

                  <h3>
                    Products
                  </h3>

                  <p>
                    Your latest products
                  </p>

                </div>

                <button
                  onClick={() =>
                    setActiveMenu("Products")
                  }
                  className="view-all"
                >
                  Manage Products →
                </button>

              </div>

              <div className="admin-products-grid">

                {products
                  .slice(0, 4)
                  .map((product) => (

                    <div
                      className="admin-product-card"
                      key={product.id}
                    >

                      <div className="admin-product-image">

                        <img
                          src={getImageUrl(
                            product.imageUrl
                          )}
                          alt={product.name}
                          onError={(event) => {
                            event.currentTarget.src =
                              "/products/tote-bow-hearts.jpeg";
                          }}
                        />

                        <span className="product-active">
                          Active
                        </span>

                      </div>

                      <div className="admin-product-info">

                        <h4>
                          {product.name}
                        </h4>

                        <div className="product-bottom">

                          <strong>
                            ₹
                            {Number(
                              product.price || 0
                            ).toLocaleString("en-IN")}
                          </strong>

                          <span>
                            ID #{product.id}
                          </span>

                        </div>

                      </div>

                    </div>

                  ))}

                {products.length === 0 && (

                  <div className="empty-products">
                    No products found.
                  </div>

                )}

              </div>

            </section>

          </div>

        )}

        {/* ==================================================
            PRODUCTS MANAGEMENT
        ================================================== */}

        {activeMenu === "Products" && (

          <ProductManagement
            onBack={() =>
              setActiveMenu("Dashboard")
            }
          />

        )}

        {/* ==================================================
            ORDERS MANAGEMENT
        ================================================== */}

        {activeMenu === "Orders" && (

          <OrderManagement
            onBack={() =>
              setActiveMenu("Dashboard")
            }
          />

        )}
        {/* CUSTOM ORDERS MANAGEMENT */}
{activeMenu === "Custom Orders" && (
  <CustomOrderManagement
    onBack={() => setActiveMenu("Dashboard")}
  />
)}

                {/* CUSTOM ORDERS MANAGEMENT */}
        {activeMenu === "Custom Orders" && (
          <CustomOrderManagement
            onBack={() => setActiveMenu("Dashboard")}
          />
        )}

              {activeMenu !== "Dashboard" &&
          activeMenu !== "Products" &&
          activeMenu !== "Orders" &&
          activeMenu !== "Custom Orders" && (

            <div className="section-placeholder">

              <div className="placeholder-icon">

                {
                  menuItems.find(
                    (item) =>
                      item.name === activeMenu
                  )?.icon
                }

              </div>

              <h1>
                {activeMenu}
              </h1>

              <p>
                This section is ready for development.
              </p>

              <button
                onClick={() =>
                  setActiveMenu("Dashboard")
                }
              >
                ← Back to Dashboard
              </button>

            </div>

          )}

      </main>

    </div>
  );
}


import { useEffect, useState } from "react";
import "./AdminDashboard.css";

const API_BASE = "http://localhost:8080";

const categories = [
  "Tote Bags",
  "Crochet",
  "Pipe-Cleaner Crafts",
  "Keychains",
  "Jewellery",
  "Hair Accessories",
  "Gifts & Hampers",
  "Other Handmade Products",
];

export default function AdminDashboard() {
  const [form, setForm] = useState({
    name: "",
    category: "Tote Bags",
    description: "",
    price: "",
    stock: "10",
  });

  const [image, setImage] = useState(null);
  const [preview, setPreview] = useState("");
  const [loading, setLoading] = useState(false);
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");

  useEffect(() => {
    if (!image) {
      setPreview("");
      return;
    }

    const url = URL.createObjectURL(image);
    setPreview(url);

    return () => URL.revokeObjectURL(url);
  }, [image]);

  function updateField(event) {
    const { name, value } = event.target;
    setForm((current) => ({ ...current, [name]: value }));
  }

  async function handleSubmit(event) {
    event.preventDefault();
    setMessage("");
    setError("");

    if (!form.name.trim()) {
      setError("Enter the product name.");
      return;
    }

    if (!form.price || Number(form.price) <= 0) {
      setError("Enter a price greater than zero.");
      return;
    }

    if (!Number.isInteger(Number(form.stock)) ||
        Number(form.stock) < 0) {
      setError("Stock must be a non-negative whole number.");
      return;
    }

    if (!image) {
      setError("Please select a product image.");
      return;
    }

    const data = new FormData();
    data.append("name", form.name.trim());
    data.append("category", form.category);
    data.append("description", form.description.trim());
    data.append("price", form.price);
    data.append("stock", form.stock);
    data.append("image", image);

    try {
      setLoading(true);

      const response = await fetch(
        `${API_BASE}/api/products/with-image`,
        {
          method: "POST",
          body: data,
        }
      );

      if (!response.ok) {
        const details = await response.text();
        throw new Error(details || "Could not add product.");
      }

      const savedProduct = await response.json();

      setMessage(
        `Product "${savedProduct.name}" was added successfully!`
      );

      setForm({
        name: "",
        category: "Tote Bags",
        description: "",
        price: "",
        stock: "10",
      });

      setImage(null);
    } catch (err) {
      setError(
        err.message || "Upload failed. Check that the backend is running."
      );
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="admin-page">
      <header className="admin-header">
        <a href="/" className="admin-brand">🌙 LunaLoop</a>
        <a href="/" className="admin-back">← Customer Store</a>
      </header>

      <main className="admin-content">
        <p className="admin-eyebrow">LUNALOOP STORE MANAGEMENT</p>
        <h1>Admin Dashboard</h1>
        <p className="admin-subtitle">
          Add a handmade product to your store collection.
        </p>

        <form className="admin-product-form" onSubmit={handleSubmit}>
          <h2>Add New Product</h2>

          {message && (
            <div className="admin-success" role="status">
              {message}
              <div>
                <a href="/" className="admin-shop-link">
                  View customer store →
                </a>
              </div>
            </div>
          )}

          {error && (
            <div className="admin-error" role="alert">
              {error}
            </div>
          )}

          <div className="admin-form-grid">
            <label>
              Product name *
              <input
                name="name"
                value={form.name}
                onChange={updateField}
                placeholder="e.g. Floral Hearts Tote"
                maxLength={150}
                required
              />
            </label>

            <label>
              Category *
              <select
                name="category"
                value={form.category}
                onChange={updateField}
              >
                {categories.map((category) => (
                  <option key={category} value={category}>
                    {category}
                  </option>
                ))}
              </select>
            </label>

            <label>
              Price (₹) *
              <input
                name="price"
                type="number"
                min="0.01"
                step="0.01"
                value={form.price}
                onChange={updateField}
                placeholder="299"
                required
              />
            </label>

            <label>
              Stock quantity *
              <input
                name="stock"
                type="number"
                min="0"
                step="1"
                value={form.stock}
                onChange={updateField}
                required
              />
            </label>
          </div>

          <label className="admin-description">
            Product description
            <textarea
              name="description"
              value={form.description}
              onChange={updateField}
              placeholder="Describe the design, materials, size and colours..."
              rows={4}
              maxLength={1000}
            />
          </label>

          <div className="admin-image-area">
            <label htmlFor="product-image">
              Product image * (JPG, PNG or WebP; max 5 MB)
            </label>

            <input
              id="product-image"
              type="file"
              accept="image/jpeg,image/png,image/webp"
              onChange={(event) =>
                setImage(event.target.files?.[0] || null)
              }
              required
            />

            {preview && (
              <img
                src={preview}
                alt="Selected product preview"
                className="admin-image-preview"
              />
            )}
          </div>

          <button
            type="submit"
            className="admin-submit"
            disabled={loading}
          >
            {loading ? "Uploading product..." : "Add Product"}
          </button>
        </form>
      </main>
    </div>
  );
}
